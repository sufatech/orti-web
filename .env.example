# Server-side runtime config for the invite page (not secrets).
# Base URL of the public API (group-service invite preview). prod: https://api.orti.app, dev: https://api-dev.orti.app
ORTI_API_BASE_URL=https://api.orti.app
# Custom URL scheme of the app for this environment: prod "orti", dev "orti-dev", local "orti-local". Must match ^[a-z][a-z0-9-]*$
ORTI_APP_SCHEME=orti
